# Workstation Manager - Environment Configuration
# Copy this file to .env and adjust if needed: cp .env.example .env

# Server Network & Timezone Settings
PORT=2301
HOST=0.0.0.0
# SERVER_URL=http://192.168.0.10:2301
TZ=Europe/Moscow


# Database Configuration
# Default is PostgreSQL container inside Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres_pass@postgres:5432/workstation_manager

# To use SQLite instead, uncomment the line below:
# DATABASE_URL=sqlite+aiosqlite:///./data/workstation_manager.db

# PostgreSQL Credentials (must match DATABASE_URL)
POSTGRES_DB=workstation_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass
POSTGRES_PORT=5432

# Wake-on-LAN Settings
WOL_BROADCAST_IP=255.255.255.255
WOL_PORT=9
